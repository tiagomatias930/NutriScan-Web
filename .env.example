# Supabase Configuration
# Get these values from your Supabase project at https://supabase.com

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (public key for client-side)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Supabase Service Role Key (for server-side operations only)
# WARNING: Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Environment
VITE_ENVIRONMENT=development

# Google Gemini API Key
VITE_GEMINI_API_KEY=your-gemini-api-key

# Debug mode (optional)
VITE_DEBUG=false

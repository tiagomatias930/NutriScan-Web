# Google Gemini API Key
# Get your API key from: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key

# Auth.js / Google OAuth
# IMPORTANT: Generate a random secret with at least 32 characters
# Use: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret

# Google OAuth credentials
# Get from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Frontend origin and auth server origin
AUTH_CLIENT_URL=http://localhost:3000
AUTH_SERVER_URL=http://localhost:3001

# Upload server URL (optional)
# If using a separate upload server
VITE_UPLOAD_SERVER_URL=http://localhost:5050

# Debug mode (optional)
VITE_DEBUG=false
